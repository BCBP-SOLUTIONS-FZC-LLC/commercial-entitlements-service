# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=commercial-entitlements
APP_ENV=dev
APP_PORT=8080
BUILD_VERSION=dev

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL takes precedence over PG_* individual vars.
DATABASE_URL=postgres://app:app@localhost:5432/commercial_entitlements?sslmode=disable
# MIGRATION_DATABASE_URL is required when PG_BOUNCER_MODE=true
# MIGRATION_DATABASE_URL=postgres://app:app@localhost:5432/commercial_entitlements?sslmode=disable
# SYSTEM_DATABASE_URL=postgres://app:app@localhost:5432/commercial_entitlements?sslmode=disable

# PG_BOUNCER_MODE=true  # set when routing app traffic through PgBouncer
# PG_STATEMENT_TIMEOUT=30s

# ── Valkey / Redis ─────────────────────────────────────────────────────────────
# Dev: plain address. Production: rediss:// URL.
VALKEY_URL=localhost:6379
# VALKEY_URL=rediss://user:password@valkey.internal:6380

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=http://localhost:4566   # LocalStack

# ── SNS topics ────────────────────────────────────────────────────────────────
# SNS_TOPIC_ENTITLEMENTS_ARN=arn:aws:sns:ap-south-1:123456789012:commercial-entitlements-events

# ── SQS queues ────────────────────────────────────────────────────────────────
# SQS_BILLING_ENTITLEMENTS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/.../billing-entitlements-q
# SQS_TENANT_ENTITLEMENTS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/.../tenant-entitlements-q
# SQS_CATALOG_ENTITLEMENTS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/.../catalog-entitlements-q
# SQS_MEMBERSHIP_ENTITLEMENTS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/.../membership-entitlements-q

# SQS_BILLING_CONCURRENCY=2
# SQS_TENANT_CONCURRENCY=2
# SQS_CATALOG_CONCURRENCY=2
# SQS_MEMBERSHIP_CONCURRENCY=2

# ── Glue schema registry ──────────────────────────────────────────────────────
# GLUE_REGISTRY_ENTITLEMENTS_NAME=commercial-entitlements-events

# ── Outbox runner ─────────────────────────────────────────────────────────────
# OUTBOX_POLL_INTERVAL=500ms
# OUTBOX_CONCURRENCY=4
# OUTBOX_CLAIM_LEASE=10m
# OUTBOX_RETENTION_DAYS=8

# ── Audit log ─────────────────────────────────────────────────────────────────
# AUDIT_LOG_BASE_URL=https://audit.internal.bcbp.io
# AUDIT_LOG_TIMEOUT_MS=5000

# ── IAM Catalog ───────────────────────────────────────────────────────────────
IAM_CATALOG_BASE_URL=http://localhost:8081
IAM_CATALOG_API_KEY=

# ── Temporal ──────────────────────────────────────────────────────────────────
TEMPORAL_HOST_PORT=localhost:7233

# ── Docs ──────────────────────────────────────────────────────────────────────
DOCS_ENABLED=true
# DOCS_AUTH_TOKEN=  # required in staging/prod when DOCS_ENABLED=true

# ── Metrics ───────────────────────────────────────────────────────────────────
METRICS_PORT=9090
# PROMETHEUS_PUSHGATEWAY_URL=http://pushgateway:9091  # for reconciler jobs

# ── Schema migration ─────────────────────────────────────────────────────────
RUN_MIGRATIONS=true

# ── Reconciler ────────────────────────────────────────────────────────────────
# RECONCILER_JOB=outbox-prune
# RECONCILER_TIMEOUT=5m
# RECONCILER_BATCH_LIMIT=500
# RECONCILER_STATEMENT_TIMEOUT=2m
# PROCESSED_EVENTS_TTL_DAYS=8
