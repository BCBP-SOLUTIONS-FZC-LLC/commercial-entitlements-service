# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.go_private_token

# Build outputs
bin/

# .coverage/ holds per-suite profiles written by test-ci; track the directory
# via .gitkeep but ignore the generated files.
.coverage/*.out
.coverage/*.raw
.coverage/*.exitcode

# Root-anchored service binaries. A bare name (no leading slash) also matches
# the cmd/<name>/ *directory* at any depth, silently hiding real source files
# from git. The /name form matches only a root-level binary (e.g. from
# `go build ./cmd/server` run without -o from the repo root).
/server
/reconciler
/worker
/migrate
/expiry
/catalog-refresh

# macOS
.DS_Store

# Editor/IDE
# .idea/
# .vscode/

# Claude Code runtime files (session state, ephemeral locks — not project code)
.claude/worktrees/
.claude/scheduled_tasks.lock

# Staged PascalCase Glue schema copies (from make schema-register / CI)
.tmp/

# Temporary files
.tmp-lld.md
