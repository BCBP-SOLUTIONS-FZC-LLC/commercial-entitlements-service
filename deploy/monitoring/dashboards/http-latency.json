{
  "title": "commercial-entitlements — HTTP Latency",
  "uid": "commercial-entitlements-latency",
  "tags": ["commercial", "entitlements", "latency", "slo"],
  "schemaVersion": 38,
  "panels": [
    {
      "title": "Request rate by status class",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (status_class) (rate(platform_http_requests_total{job=\"commercial-entitlements\", environment=\"$environment\"}[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "title": "5xx error rate",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (domain, service) (rate(platform_http_requests_total{job=\"commercial-entitlements\", status_class=\"5xx\", environment=\"$environment\"}[5m])) / sum by (domain, service) (rate(platform_http_requests_total{job=\"commercial-entitlements\", environment=\"$environment\"}[5m]))",
          "legendFormat": "5xx rate"
        }
      ]
    },
    {
      "title": "p50 / p95 / p99 latency (seconds)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(platform_http_request_duration_seconds_bucket{job=\"commercial-entitlements\", environment=\"$environment\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(platform_http_request_duration_seconds_bucket{job=\"commercial-entitlements\", environment=\"$environment\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(platform_http_request_duration_seconds_bucket{job=\"commercial-entitlements\", environment=\"$environment\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Latency by route (p95)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(platform_http_request_duration_seconds_bucket{job=\"commercial-entitlements\", environment=\"$environment\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "options": [{"value": "prod"}, {"value": "staging"}, {"value": "dev"}],
        "current": {"value": "prod"}
      }
    ]
  }
}
