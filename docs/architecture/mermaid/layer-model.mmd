graph TD
    subgraph cmd["Composition Roots — cmd/ (six binaries, one image)"]
        server["server/main.go\nwire all dependencies\npgcommon.NewPool with GUCProvider = GUCSetFromContext (RLS-6) + BYPASSRLS sysPool\nRUN_MIGRATIONS false (Helm hook owns it)\nrouter registration + gincommon.ObservabilityMiddlewares\n/metrics = gincommon.MetricsHandler() on METRICS_PORT (9090)\n4 SQS consumers via sqspipeline:\n  billing-entitlements-q · tenant-entitlements-q\n  catalog-entitlements-q · membership-entitlements-q\nRoutingPublisher (1 SNS topic: commercial-entitlements-events, GlueCodec)\noutbox runner + auditoutbox runner\nTemporal client starter (optional, skipped when TEMPORAL_HOST_PORT unset)\ngraceful shutdown: SIGTERM → HTTP + SQS drain (parallel, ≤30s) → outbox (30s) → pools\nterminationGracePeriodSeconds=75"]
        reconciler["reconciler/main.go\nsingle binary, --job=<name> dispatch\nselects one of 5 CronJobs:\n  override-expiry · addon-expiry\n  outbox-prune · processed-events-prune\n  quota-reset\nRECONCILER_STATEMENT_TIMEOUT (2m) on both pools\nmetrics pushed to PROMETHEUS_PUSHGATEWAY_URL"]
        worker["worker/main.go\nTemporal workflow worker\ncatalog fan-out workflow"]
        migrate["migrate/main.go\npgmigrate.Run() against MIGRATION_DATABASE_URL\nHelm pre-install/pre-upgrade hook"]
        expiry["expiry/main.go\nstandalone addon/override expiry sweep\ncan run as a one-shot job"]
        catalogrefresh["catalog-refresh/main.go\npulls IAM plan catalog into Postgres + Valkey\ncalls IAM_CATALOG_BASE_URL"]
    end

