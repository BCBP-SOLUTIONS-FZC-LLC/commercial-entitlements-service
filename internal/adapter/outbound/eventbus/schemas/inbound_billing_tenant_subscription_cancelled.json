{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InboundBillingTenantSubscriptionCancelledPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "cancelled_at",
    "reason"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "enum": [
        "dunning_exhausted",
        "customer",
        "auto_renew_off",
        "operator_reversal"
      ]
    }
  }
}
