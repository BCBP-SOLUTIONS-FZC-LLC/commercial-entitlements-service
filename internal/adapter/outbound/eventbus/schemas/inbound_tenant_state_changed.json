{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InboundTenantStateChangedPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "status",
    "previous_status",
    "cause",
    "changed_at"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string"
    },
    "previous_status": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "previous_plan": {
      "type": "string"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "cause": {
      "type": "string"
    }
  }
}
