{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TenantEntitlementsChanged",
  "type": "object",
  "required": ["tenant_id", "version", "cause", "computed_at"],
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid",
      "description": "The tenant whose entitlements were recomputed."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing snapshot version."
    },
    "cause": {
      "type": "string",
      "enum": [
        "plan_change", "override_change", "addon_change", "trial_change",
        "catalog_refresh", "billing_event", "manual_recompute",
        "tenant_lifecycle", "shortfall_resolution"
      ],
      "description": "What triggered this recomputation."
    },
    "changed_keys": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Limit keys whose values changed in this version (empty = full refresh)."
    },
    "previous_version": {
      "type": "integer",
      "minimum": 0
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
