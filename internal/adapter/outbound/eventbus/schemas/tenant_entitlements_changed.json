{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TenantEntitlementsChangedPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "version",
    "cause",
    "computed_at"
  ],
  "additionalProperties": true,
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cause": {
      "type": "string",
      "enum": [
        "plan_change",
        "override_change",
        "addon_change",
        "trial_change",
        "catalog_refresh",
        "billing_event",
        "manual_recompute",
        "tenant_lifecycle",
        "shortfall_resolution"
      ]
    },
    "changed_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "previous_version": {
      "type": "integer",
      "minimum": 0
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
